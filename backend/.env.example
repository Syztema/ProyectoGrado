# Configuración del Backend Integrado
# Copia este archivo como .env y configura tus valores

# =====================================
# CONFIGURACIÓN DEL SERVIDOR
# =====================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=https://localhost:3000

# URLs permitidas para CORS (separadas por comas)
CORS_ORIGINS=https://localhost:3000,http://localhost:3000

# =====================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# =====================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=mi_base_de_datos

# =====================================
# CONFIGURACIÓN DE SESIONES
# =====================================
SESSION_SECRET=tu-clave-secreta-super-segura
SESSION_TIMEOUT=86400000
# Timeout en milisegundos (86400000 = 24 horas)

# =====================================
# CONFIGURACIÓN DE ACTIVE DIRECTORY (OPCIONAL)
# =====================================
# Descomenta y configura si quieres usar AD además de MySQL

# AD_URL=ldap://tu-servidor-ad.empresa.com
# AD_BASE_DN=dc=empresa,dc=com  
# AD_USERNAME=usuario-servicio@empresa.com
# AD_PASSWORD=password-del-usuario-servicio

# OUs permitidas (separadas por comas)
# ALLOWED_OUS=OU=ComputadorasPermitidas,OU=Estaciones,DC=empresa,DC=com,OU=EstacionesAdmin,OU=IT,DC=empresa,DC=com

# =====================================
# CONFIGURACIÓN DEL SISTEMA DE SEGURIDAD
# =====================================

# Método de autenticación: mysql, ad, mixed
# mysql = Solo base de datos MySQL
# ad = Solo Active Directory
# mixed = Primero MySQL, luego AD si falla
AUTH_METHOD=ad

# Máximo de dispositivos por usuario
MAX_DEVICES_PER_USER=3

# Auto-autorizar nuevos dispositivos (true/false)
AUTO_AUTHORIZE_DEVICES=true

# Días de inactividad antes de revocar dispositivo
DEVICE_INACTIVITY_DAYS=90

# =====================================
# CONFIGURACIÓN DE RATE LIMITING
# =====================================
RATE_LIMIT_WINDOW=900000
# Ventana de tiempo en ms (900000 = 15 minutos)
RATE_LIMIT_MAX=100
# Máximo de requests por ventana

# =====================================
# CONFIGURACIÓN DE LOGS Y AUDITORÍA
# =====================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/app.log

# Habilitar logs de auditoría detallados
ENABLE_AUDIT_LOGS=true

# =====================================
# CONFIGURACIÓN DE GEOLOCALIZACIÓN
# =====================================
# Coordenadas del polígono de área permitida (formato JSON)
# Ejemplo: [[-74.0812,4.6097],[-74.0810,4.6095],[-74.0808,4.6098],[-74.0812,4.6097]]
#ALLOWED_POLYGON=[]

# =====================================
# CONFIGURACIÓN DE SEGURIDAD
# =====================================
# Forzar HTTPS en producción
FORCE_HTTPS=false

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000

# Habilitar helmet para headers de seguridad
ENABLE_HELMET=true

# =====================================
# CONFIGURACIÓN DE CORREO (OPCIONAL)
# =====================================
# Para notificaciones de dispositivos no autorizados

# SMTP_HOST=smtp.empresa.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@empresa.com
# SMTP_PASSWORD=password-smtp
# SMTP_FROM=Sistema de Acceso <noreply@empresa.com>

# Lista de emails para notificaciones de admin (separados por comas)
# ADMIN_EMAILS=admin1@empresa.com,admin2@empresa.com

# =====================================
# CONFIGURACIÓN DE DESARROLLO/DEBUG
# =====================================
DEBUG_MODE=true
VERBOSE_LOGGING=false

# Mostrar queries SQL en desarrollo
SHOW_SQL_QUERIES=false

# =====================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =====================================
# Descomenta para producción

# NODE_ENV=production
# DEBUG_MODE=false
# FORCE_HTTPS=true
# SESSION_TIMEOUT=28800000
# RATE_LIMIT_MAX=50
# AUTO_AUTHORIZE_DEVICES=false
# LOG_LEVEL=error
# FRONTEND_URL=https://tu-dominio.com

# =====================================
# CONFIGURACIÓN DE CLUSTERING (OPCIONAL)
# =====================================
# Para balanceador de carga en producción

# CLUSTER_MODE=false
# CLUSTER_WORKERS=auto
# REDIS_SESSION_STORE=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# =====================================
# CONFIGURACIÓN DE BACKUP
# =====================================
# AUTO_BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=30
# BACKUP_PATH=./backups