HTTPS=true
SSL_CRT_FILE=../ssl/cert.pem
SSL_KEY_FILE=../ssl/key.pem

# Configuración del Frontend - React
# Copia este archivo como .env y configura tus valores

# URL del backend API
REACT_APP_API_URL=http://localhost:3001

# Configuración de desarrollo
REACT_APP_ENV=development

# Configuración de geolocalización
REACT_APP_GEOLOCATION_TIMEOUT=10000
REACT_APP_GEOLOCATION_HIGH_ACCURACY=true
REACT_APP_GEOLOCATION_MAX_AGE=60000

# Configuración de mapas
REACT_APP_MAP_DEFAULT_ZOOM=17
REACT_APP_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Configuración de device fingerprinting
REACT_APP_FINGERPRINT_ENABLED=true
REACT_APP_CANVAS_FINGERPRINT=true
REACT_APP_WEBGL_FINGERPRINT=true
REACT_APP_AUDIO_FINGERPRINT=true

# Configuración de debug y logs
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=warn

# Configuración de seguridad
REACT_APP_SESSION_TIMEOUT=3600000
REACT_APP_AUTO_LOGOUT_WARNING=300000

# Configuración de UI
REACT_APP_THEME=default
REACT_APP_SHOW_DEBUG_INFO=false

# URLs de ayuda y soporte
REACT_APP_HELP_URL=https://help.empresa.com
REACT_APP_SUPPORT_EMAIL=soporte@empresa.com

# Configuración de errores
REACT_APP_ERROR_REPORTING=false
REACT_APP_SENTRY_DSN=

# Configuración específica para producción
# REACT_APP_API_URL=https://api.empresa.com
# REACT_APP_ENV=production
# REACT_APP_DEBUG_MODE=false
# REACT_APP_LOG_LEVEL=error